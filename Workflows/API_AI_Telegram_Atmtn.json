    {
      "parameters": {
        "jsCode": "// Get the response from the Basic LLM Chain\nlet rawData = $input.first().json.text;\n\n// Make sure we actually received text\nif (!rawData) {\n  throw new Error(\"No text received from Basic LLM Chain\");\n}\n\n// Remove ```json and ``` markdown code fences\nrawData = rawData\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\n// Convert the cleaned string into a JSON object\nconst emailData = JSON.parse(rawData);\n\n// Return clean JSON\nreturn [\n  {\n    json: {\n      to: emailData.to,\n      subject: emailData.subject,\n      body: emailData.body\n    }\n  }\n];"
      },
